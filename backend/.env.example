# ============================================
# BizReels Backend Environment Configuration Example
# ============================================

# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
CORS_ORIGIN=*

# Database & Cache
MONGODB_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/bizreels?retryWrites=true&w=majority
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# JWT Authentication
JWT_ACCESS_SECRET=your_access_token_secret_here_min_32_chars
JWT_REFRESH_SECRET=your_refresh_token_secret_here_min_32_chars
JWT_ACCESS_EXPIRY=60d
JWT_REFRESH_EXPIRY=60d

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
STORAGE_PROVIDER=cloudinary
UPLOAD_TEMP_DIR=uploads/temp
UPLOAD_PROCESSED_DIR=uploads/processed
MAX_UPLOAD_SIZE=10485760
MAX_IMAGE_WIDTH=1920
WEBP_QUALITY=80

# Razorpay Payments
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Email (Resend API)
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=BizReels <admin@yourdomain.com>

# Sandbox API Verification (PAN, Aadhaar OKYC, GSTIN, Bank)
SANDBOX_API_KEY=key_live_your_sandbox_api_key
SANDBOX_API_SECRET=secret_live_your_sandbox_api_secret
SANDBOX_BASE_URL=https://api.sandbox.co.in

# SMS & OTP Configuration (Twilio DLT)
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_MESSAGING_SERVICE_SID=MGfc719c901c221e6589477022886b1f94
TWILIO_SENDER_ID=BZREEL
TWILIO_DLT_TEMPLATE_ID=1277178706040137501
TWILIO_DLT_PE_ID=your_dlt_principal_entity_id_here
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_COOLDOWN_SECONDS=60

# AI & OpenRouter
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openrouter/free

# Shiprocket Logistics & Courier Shipping
SHIPROCKET_EMAIL=your_shiprocket_registered_email@example.com
SHIPROCKET_PASSWORD=your_shiprocket_password
SHIPROCKET_API_TOKEN=optional_direct_pre_generated_bearer_token
SHIPROCKET_PICKUP_PINCODE=110001
SHIPROCKET_DEV_MODE=false

# Dev Modes & Overrides
OTP_DEV_MODE=false
CLOUDINARY_DEV_MODE=false
RAZORPAY_DEV_MODE=false
FCM_DEV_MODE=true
SEED_ADMIN_ON_STARTUP=true
DEV_ADMIN_OVERRIDE_TOKEN=your_admin_dev_token

