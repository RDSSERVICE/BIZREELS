# ============================================
# BizReels Backend Environment Configuration Example
# ============================================

# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
CORS_ORIGIN=*

# MongoDB
MONGODB_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/bizreels?retryWrites=true&w=majority

# Redis
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# JWT Authentication
JWT_ACCESS_SECRET=your_access_token_secret_here_min_32_chars
JWT_REFRESH_SECRET=your_refresh_token_secret_here_min_32_chars
JWT_ACCESS_EXPIRY=30m
JWT_REFRESH_EXPIRY=7d

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Firebase (OTP / Notifications)
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_PRIVATE_KEY=your_private_key
FIREBASE_CLIENT_EMAIL=your_client_email

# Razorpay Payments
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Stripe Payments
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# ============================================
# Email Service (Resend API)
# ============================================
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=BizReels <admin@yourdomain.com>

# ============================================
# Sandbox Verification APIs (PAN, Aadhaar OKYC, GSTIN, Bank)
# ============================================
SANDBOX_API_KEY=key_live_your_sandbox_api_key
SANDBOX_API_SECRET=secret_live_your_sandbox_api_secret
SANDBOX_BASE_URL=https://api.sandbox.co.in

# OTP Configuration
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_COOLDOWN_SECONDS=60
SEED_ADMIN_ON_STARTUP=true
OTP_DEV_MODE=false

# Upload & Sharp Compression
UPLOAD_TEMP_DIR=uploads/temp
UPLOAD_PROCESSED_DIR=uploads/processed
MAX_UPLOAD_SIZE=10485760
MAX_IMAGE_WIDTH=1920
WEBP_QUALITY=80
STORAGE_PROVIDER=cloudinary

# SMS & WhatsApp Gateway Provider ('twilio' or 'mock')
SMS_PROVIDER=twilio
WHATSAPP_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_MESSAGING_SERVICE_SID=MGfc719c901c221e6589477022886b1f94
TWILIO_SENDER_ID=BZREEL
TWILIO_DLT_TEMPLATE_ID=1277178706040137501
TWILIO_DLT_PE_ID=your_dlt_principal_entity_id_here
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_CONTENT_SID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEV_ADMIN_OVERRIDE_TOKEN=your_admin_dev_token

# ============================================
# AI & OpenRouter Integration
# ============================================
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openrouter/free
